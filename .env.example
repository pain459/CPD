# Copy to .env and adjust. See .env for the fixed non-colliding ports.
# S3 backend is RustFS (Apache-2.0). MinIO is archived — do not use.
CPD_BIND_ADDRESS=127.0.0.1
CPD_UI_PORT=8180
CPD_API_PORT=8181
CPD_POSTGRES_PORT=5433
CPD_REDIS_PORT=6380
CPD_S3_API_PORT=9190
CPD_S3_CONSOLE_PORT=9191

POSTGRES_DB=cpd
POSTGRES_USER=cpd
POSTGRES_PASSWORD=change_me
S3_ACCESS_KEY=cpdadmin
S3_SECRET_KEY=change_me_long_enough
S3_BUCKET=cpd-raw
